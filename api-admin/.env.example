# App
SERVICE_PORT=1502
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Database - Master
CONFIG_POSTGRESQL_HOST_MASTER=172.16.10.146
CONFIG_POSTGRESQL_PORT_MASTER=5432
CONFIG_POSTGRESQL_DB_NAME_MASTER=techres_master
CONFIG_POSTGRESQL_USERNAME_MASTER=techres_master
CONFIG_POSTGRESQL_PASSWORD_MASTER=techres_master

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Internal Services (ports updated for APISIX gateway)
CONFIG_API_NODEJS_MANAGEMENT_URL=http://localhost:1503
CONFIG_API_NODEJS_SOCKET_URL=http://localhost:1507

# API App Food - for syncing food platform accounts
CONFIG_API_NODEJS_APP_FOOD_URL=http://localhost:3010

# Logger
CONFIG_LOGGER_LEVEL=debug
