# Database
CONFIG_POSTGRESQL_HOST=172.16.10.146
CONFIG_POSTGRESQL_PORT=5432
CONFIG_POSTGRESQL_USERNAME=techres
CONFIG_POSTGRESQL_PASSWORD=techres
CONFIG_POSTGRESQL_DB_NAME=techres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Server
SERVICE_PORT=4002
NODE_ENV=development

# Webhook Service (for multi-tenant PayOS config sync)
WEBHOOK_SERVICE_URL=http://localhost:3006

# PayOS (optional - credentials are stored per-branch in database)
PAYOS_RETURN_URL=https://techres.vn/payment/success
PAYOS_CANCEL_URL=https://techres.vn/payment/cancel
