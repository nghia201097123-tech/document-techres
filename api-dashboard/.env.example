# App
SERVICE_PORT=1503
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Database - TechRes
CONFIG_POSTGRESQL_HOST_TECHRES=172.16.10.146
CONFIG_POSTGRESQL_PORT_TECHRES=5432
CONFIG_POSTGRESQL_DB_NAME_TECHRES=techres
CONFIG_POSTGRESQL_USERNAME_TECHRES=techres
CONFIG_POSTGRESQL_PASSWORD_TECHRES=techres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Internal Services (ports updated for APISIX gateway)
CONFIG_API_NODEJS_SOCKET_URL=http://localhost:1507
CONFIG_API_NODEJS_WEBHOOK_URL=http://localhost:1508

# PayOS (optional - credentials are stored per-branch in database)
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://techres.vn/payment/success
PAYOS_CANCEL_URL=https://techres.vn/payment/cancel

# Logger
CONFIG_LOGGER_LEVEL=debug
