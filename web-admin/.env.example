# App
SERVICE_PORT=1500
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# APISIX Gateway Configuration
# Gateway sẽ điều hướng request dựa trên header ProjectId
NEXT_PUBLIC_GATEWAY_URL=http://172.16.10.118:7080

# Service Port IDs (dùng làm ProjectId header khi gọi qua gateway)
NEXT_PUBLIC_API_ADMIN_PORT=1502
NEXT_PUBLIC_API_DASHBOARD_PORT=1503
NEXT_PUBLIC_API_MASTER_DATA_PORT=1504
NEXT_PUBLIC_API_UPLOAD_PORT=1505
NEXT_PUBLIC_API_OAUTH_PORT=1506
NEXT_PUBLIC_SOCKET_PORT=1507

# Legacy API URL (fallback)
NEXT_PUBLIC_API_URL=http://172.16.10.118:7080/api
CONFIG_RESOURCE_URL=

# Service IDs
CONFIG_NODEJS_ADMIN_SERVICE_ID=
CONFIG_NODEJS_MANAGEMENT_SERVICE_ID=
CONFIG_NODEJS_MEDIA_SERVICE_ID=
CONFIG_NODEJS_OAUTH_SERVICE_ID=

# Logger
CONFIG_LOGGER_LEVEL=debug
