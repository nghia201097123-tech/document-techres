# App
SERVICE_PORT=1500
# NOTE: NODE_ENV is controlled by Next.js, not this file!
# - `npm run dev` (next dev) → NODE_ENV = 'development'
# - `npm start` (next start) → NODE_ENV = 'production' (always!)
# NODE_ENV=development  # This has NO EFFECT on Next.js

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# =============================================================
# APISIX Gateway URL
# =============================================================
# Gateway sẽ điều hướng request dựa trên header x-svc-id
#
# IMPORTANT: NEXT_PUBLIC_* variables behavior in Next.js:
# - These are INLINED at BUILD TIME, not read at runtime
# - For Docker: Use placeholder "CONFIG_VALUE_NEXT_PUBLIC_API_URL" during build
# - The entrypoint.sh script will replace it with actual value at container start
#
# For local development:
NEXT_PUBLIC_API_URL=https://beta.api.gateway.overate-vntech.com

# For Docker build (set in Dockerfile):
# ENV NEXT_PUBLIC_API_URL=CONFIG_VALUE_NEXT_PUBLIC_API_URL
# Then pass actual value when running container:
# docker run -e NEXT_PUBLIC_API_URL=https://your-api.com ...
#
# This variable can be changed at runtime (no NEXT_PUBLIC_ prefix)
CONFIG_RESOURCE_URL=https://beta.api.gateway.overate-vntech.com/s3

# Service IDs (dùng làm x-svc-id header khi gọi qua gateway)
CONFIG_NODEJS_ADMIN_SERVICE_ID=1502
CONFIG_NODEJS_MANAGEMENT_SERVICE_ID=1503
CONFIG_NODEJS_MEDIA_SERVICE_ID=1505
CONFIG_NODEJS_OAUTH_SERVICE_ID=1506

# Logger
CONFIG_LOGGER_LEVEL=debug
