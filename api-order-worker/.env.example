# ============================================
# MICROSERVICE 2: ORDER WORKER SERVICE
# ============================================

# Server
PORT=3002
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=food_platform
DB_LOGGING=false

# Redis (for caching, pub/sub, and Bull queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Bull Queue Settings
BULL_QUEUE_PREFIX=food-order

# Piscina Worker Settings
PISCINA_MIN_THREADS=2
PISCINA_MAX_THREADS=10
PISCINA_IDLE_TIMEOUT=60000

# Platform API URLs
GRAB_API_URL=https://api.grab.com/food/merchant/v3
SHOPEE_API_URL=https://api.shopeefood.vn/merchant/v4
BEFOOD_API_URL=https://gw.be.com.vn/api/v1/be-merchant-gateway

# Polling Settings
POLL_LOCK_TTL=10
CACHE_TTL=10

# WebSocket
WS_CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=*
