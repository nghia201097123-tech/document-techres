# ============================================
# MICROSERVICE 2: ORDER WORKER SERVICE
# Poll đơn hàng từ platforms, lưu DB, push realtime
# ============================================

# App
SERVICE_PORT=3002
NODE_ENV=development
API_PREFIX=api/v1

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Database - App Food
CONFIG_POSTGRESQL_HOST_APP_FOOD=172.16.10.146
CONFIG_POSTGRESQL_PORT_APP_FOOD=5432
CONFIG_POSTGRESQL_DB_NAME_APP_FOOD=techres_app_food
CONFIG_POSTGRESQL_USERNAME_APP_FOOD=techres_app_food
CONFIG_POSTGRESQL_PASSWORD_APP_FOOD=techres_app_food
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis (Cache, Pub/Sub, Bull Queue)
CONFIG_REDIS_HOST=172.16.10.146
CONFIG_REDIS_PORT=6379
CONFIG_REDIS_PASSWORD=
CONFIG_REDIS_DB=0

# Bull Queue
CONFIG_BULL_QUEUE_PREFIX=food-order
CONFIG_BULL_QUEUE_ATTEMPTS=3
CONFIG_BULL_QUEUE_BACKOFF_DELAY=2000

# Piscina Worker Pool Settings
CONFIG_PISCINA_MIN_THREADS=2
CONFIG_PISCINA_MAX_THREADS=10
CONFIG_PISCINA_IDLE_TIMEOUT_MS=60000

# Platform API Configurations
# GrabFood
GRAB_API_BASE_URL=https://api.grab.com/food/merchant/v3
GRAB_CLIENT_ID=your-grab-client-id
GRAB_CLIENT_SECRET=your-grab-client-secret

# ShopeeFood
SHOPEE_FOOD_API_BASE_URL=https://api.shopeefood.vn/merchant/v4
SHOPEE_FOOD_CLIENT_ID=your-shopee-client-id
SHOPEE_FOOD_CLIENT_SECRET=your-shopee-client-secret

# BeFood
BEFOOD_API_BASE_URL=https://gw.be.com.vn/api/v1/be-merchant-gateway
BEFOOD_CLIENT_ID=your-befood-client-id
BEFOOD_CLIENT_SECRET=your-befood-client-secret

# Polling Configuration
DEFAULT_POLL_INTERVAL_SECONDS=30
MIN_POLL_INTERVAL_SECONDS=5
MAX_POLL_INTERVAL_SECONDS=60
POLL_TIMEOUT_MS=10000
POLL_LOCK_TTL_SECONDS=10

# Cache Configuration
CONFIG_CACHE_TTL_SECONDS=10
CONFIG_CACHE_PREFIX=orders

# WebSocket
CONFIG_WS_NAMESPACE=/orders
CONFIG_WS_CORS_ORIGIN=*

# Logger
CONFIG_LOGGER_LEVEL=debug

# CORS
CORS_ORIGIN=*
