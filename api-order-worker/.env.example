# =============================================================
# HARDCODED DEFAULTS (configured in code, override if needed)
# =============================================================
# API_PREFIX=api/v1 (hardcoded in main.ts)
# CONFIG_WS_NAMESPACE=/orders (hardcoded in orders.gateway.ts)
# CONFIG_WS_CORS_ORIGIN=* (hardcoded in orders.gateway.ts)
# CORS_ORIGIN=* (hardcoded in main.ts)
#
# Bull Queue (hardcoded in app.module.ts):
# - attempts: 3
# - backoff delay: 2000ms
#
# Piscina Worker Pool (hardcoded in worker-manager.service.ts):
# - minThreads: 2
# - maxThreads: 10
# - idleTimeout: 60000ms (1 min)
#
# Polling intervals (read from platform config, defaults):
# - DEFAULT_POLL_INTERVAL_SECONDS=30
# - MIN_POLL_INTERVAL_SECONDS=5
# - MAX_POLL_INTERVAL_SECONDS=60
# - POLL_TIMEOUT_MS=10000
