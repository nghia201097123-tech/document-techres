# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=techres_app_food
DB_PASSWORD=techres_app_food
DB_DATABASE=techres_app_food
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT (for future auth)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption Key for credentials (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Platform API Configurations
# GrabFood
GRAB_API_BASE_URL=https://api.grab.com/merchant/v2
GRAB_CLIENT_ID=your-grab-client-id
GRAB_CLIENT_SECRET=your-grab-client-secret

# ShopeeFood
SHOPEE_FOOD_API_BASE_URL=https://api.shopeefood.vn/merchant/v4
SHOPEE_FOOD_CLIENT_ID=your-shopee-client-id
SHOPEE_FOOD_CLIENT_SECRET=your-shopee-client-secret

# BeFood
BEFOOD_API_BASE_URL=https://api.befood.vn/merchant
BEFOOD_CLIENT_ID=your-befood-client-id
BEFOOD_CLIENT_SECRET=your-befood-client-secret

# Polling Configuration
DEFAULT_POLL_INTERVAL_SECONDS=30
MIN_POLL_INTERVAL_SECONDS=5
MAX_POLL_INTERVAL_SECONDS=60
POLL_TIMEOUT_MS=10000

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30
