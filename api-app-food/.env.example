# App
SERVICE_PORT=3010
NODE_ENV=development
API_PREFIX=api

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Database - App Food
CONFIG_POSTGRESQL_HOST_APP_FOOD=172.16.10.146
CONFIG_POSTGRESQL_PORT_APP_FOOD=5432
CONFIG_POSTGRESQL_DB_NAME_APP_FOOD=techres_app_food
CONFIG_POSTGRESQL_USERNAME_APP_FOOD=techres_app_food
CONFIG_POSTGRESQL_PASSWORD_APP_FOOD=techres_app_food
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis (Cache, Pub/Sub)
CONFIG_REDIS_HOST=172.16.10.71
CONFIG_REDIS_PORT=6379
CONFIG_REDIS_PASSWORD=GNwHez7OT53ftK5Ui3IOOlg1jUMwKT5
CONFIG_REDIS_DB=6

# WebSocket
CONFIG_WS_CORS_ORIGIN=*

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for credentials (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Platform API Configurations
# GrabFood (MEX API)
GRAB_API_BASE_URL=https://api.grab.com/mex-app
GRAB_CLIENT_ID=your-grab-client-id
GRAB_CLIENT_SECRET=your-grab-client-secret

# ShopeeFood
SHOPEE_FOOD_API_BASE_URL=https://api.shopeefood.vn/merchant/v4
SHOPEE_FOOD_CLIENT_ID=your-shopee-client-id
SHOPEE_FOOD_CLIENT_SECRET=your-shopee-client-secret

# BeFood
BEFOOD_API_BASE_URL=https://api.befood.vn/merchant
BEFOOD_CLIENT_ID=your-befood-client-id
BEFOOD_CLIENT_SECRET=your-befood-client-secret

# Polling Configuration
DEFAULT_POLL_INTERVAL_SECONDS=30
MIN_POLL_INTERVAL_SECONDS=5
MAX_POLL_INTERVAL_SECONDS=60
POLL_TIMEOUT_MS=10000

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30

# Logger
CONFIG_LOGGER_LEVEL=debug
