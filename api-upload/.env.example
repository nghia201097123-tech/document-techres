# Server
SERVICE_PORT=3003
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# MinIO Configuration
CONFIG_MINIO_ENDPOINT=s3.techres.vn
CONFIG_MINIO_PORT=443
CONFIG_MINIO_ENABLE_SSL=true
CONFIG_MINIO_ACCESSKEY=your-access-key
CONFIG_MINIO_SECRETKEY=your-secret-key
CONFIG_MINIO_BUCKET=techres-uploads
