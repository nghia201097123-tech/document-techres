# Server
PORT=3003

# MinIO Configuration
MINIO_ENDPOINT=s3.techres.vn
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=techres-uploads

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Upload Limits (in MB)
MAX_IMAGE_SIZE=10
MAX_VIDEO_SIZE=100
MAX_DOCUMENT_SIZE=50
