# Server
PORT=3003

# MinIO Configuration (using CONFIG_MINIO_* naming convention)
CONFIG_MINIO_ENDPOINT=s3.techres.vn
CONFIG_MINIO_PORT=443
CONFIG_MINIO_ENABLE_SSL=true
CONFIG_MINIO_ACCESSKEY=your_access_key
CONFIG_MINIO_SECRETKEY=your_secret_key
CONFIG_MINIO_BUCKET=techres-uploads
CONFIG_MINIO_REGION=us-east-1

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Upload Limits (in MB)
MAX_IMAGE_SIZE=10
MAX_VIDEO_SIZE=100
MAX_DOCUMENT_SIZE=50
