# App
SERVICE_PORT=1501
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# APISIX Gateway URL
# Gateway sẽ điều hướng request dựa trên header x-svc-id
NEXT_PUBLIC_API_URL=http://172.16.10.118:7080
CONFIG_RESOURCE_URL=http://172.16.10.118:7080/s3

# Service IDs (dùng làm x-svc-id header khi gọi qua gateway)
CONFIG_NODEJS_ADMIN_SERVICE_ID=1502
CONFIG_NODEJS_MANAGEMENT_SERVICE_ID=1503
CONFIG_NODEJS_MEDIA_SERVICE_ID=1505
CONFIG_NODEJS_OAUTH_SERVICE_ID=1506

# API App Food (direct, không qua gateway)
NEXT_PUBLIC_API_APP_FOOD_URL=http://172.16.10.201:3010/api

# Logger
CONFIG_LOGGER_LEVEL=debug
