# App
SERVICE_PORT=1501
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# APISIX Gateway URL
# Gateway sẽ điều hướng request dựa trên header x-svc-id
NEXT_PUBLIC_API_URL=https://beta.api.gateway.overate-vntech.com
CONFIG_RESOURCE_URL=https://beta.api.gateway.overate-vntech.com/s3

# Service IDs (dùng làm x-svc-id header khi gọi qua gateway)
CONFIG_NODEJS_ADMIN_SERVICE_ID=1502
CONFIG_NODEJS_MANAGEMENT_SERVICE_ID=1503
CONFIG_NODEJS_MEDIA_SERVICE_ID=1505
CONFIG_NODEJS_OAUTH_SERVICE_ID=1506
CONFIG_NODEJS_APP_FOOD_SERVICE_ID=1509

# =============================================================
# API App Food (DEPRECATED - now uses gateway with x-svc-id=1509)
# =============================================================
# CONFIG_API_APP_FOOD_URL=http://172.16.10.201:3010/api

# Logger
CONFIG_LOGGER_LEVEL=debug
