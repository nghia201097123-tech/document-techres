# Server
SERVICE_PORT=3006

# PayOS Configuration (OPTIONAL - for single-tenant/fallback only)
# Multi-tenant: checksumKey is synced per-orderCode from api-dashboard via /config/payos/register
# This env var is only used as fallback when no config is registered for an orderCode
PAYOS_CHECKSUM_KEY=

# Socket Service (HTTP API)
SOCKET_SERVICE_URL=http://localhost:3007

# Logging
LOG_LEVEL=debug
