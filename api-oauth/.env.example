# App
SERVICE_PORT=1506
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Database - OAuth
CONFIG_POSTGRESQL_HOST_OAUTH=172.16.10.146
CONFIG_POSTGRESQL_PORT_OAUTH=5432
CONFIG_POSTGRESQL_DB_NAME_OAUTH=fnbpos_oauth
CONFIG_POSTGRESQL_USERNAME_OAUTH=fnbpos_oauth
CONFIG_POSTGRESQL_PASSWORD_OAUTH=fnbpos_oauth

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# 2FA
TWO_FACTOR_APP_NAME=FNB_POS

# Password Reset
PASSWORD_RESET_EXPIRES_IN=3600000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# CORS (ports updated for APISIX gateway)
CORS_ORIGINS=http://localhost:1500,http://localhost:1501

# Email (for password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@fnbpos.com
SMTP_PASS=password
SMTP_FROM=noreply@fnbpos.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:1506/api/v1/auth/google/callback

# Facebook OAuth (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:1506/api/v1/auth/facebook/callback

# Logger
CONFIG_LOGGER_LEVEL=debug
