# ============================================
# MICROSERVICE 1: ACCOUNT SERVICE
# ============================================

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=food_platform
DB_LOGGING=false

# Redis (for caching and communication)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (for internal API authentication)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Encryption (for storing account credentials)
ENCRYPTION_KEY=your-32-character-encryption-key

# Platform API URLs (optional overrides)
GRAB_API_URL=https://api.grab.com
SHOPEE_API_URL=https://api.shopeefood.vn/merchant/v4
BEFOOD_API_URL=https://gw.be.com.vn/api/v1/be-merchant-gateway

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=*
