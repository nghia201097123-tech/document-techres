# App
SERVICE_PORT=3004
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Database - TechRes
CONFIG_POSTGRESQL_HOST_TECHRES=172.16.10.146
CONFIG_POSTGRESQL_PORT_TECHRES=5432
CONFIG_POSTGRESQL_DB_NAME_TECHRES=techres
CONFIG_POSTGRESQL_USERNAME_TECHRES=techres
CONFIG_POSTGRESQL_PASSWORD_TECHRES=techres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Internal Services
CONFIG_API_NODEJS_APP_FOOD_URL=http://localhost:3010

# Logger
CONFIG_LOGGER_LEVEL=debug
