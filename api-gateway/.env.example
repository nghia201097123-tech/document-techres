# App
SERVICE_PORT=4000
NODE_ENV=development

# Build Info
CONFIG_BUILD_NUMBER=
CONFIG_BUILD_TIME=

# Backend Services
CONFIG_API_NODEJS_ADMIN_URL=http://localhost:3002
CONFIG_API_NODEJS_MANAGEMENT_URL=http://localhost:4002
CONFIG_API_NODEJS_OAUTH_URL=http://localhost:3005
CONFIG_API_NODEJS_WEBHOOK_URL=http://localhost:3006
CONFIG_API_NODEJS_SOCKET_URL=http://localhost:3007

# Web Frontend (for CORS)
CONFIG_WEB_ADMIN_URL=http://localhost:3000
CONFIG_WEB_DASHBOARD_URL=http://localhost:3001

# PayOS Configuration
# Get credentials from https://my.payos.vn/
PAYOS_CLIENT_ID=your_client_id
PAYOS_API_KEY=your_api_key
PAYOS_CHECKSUM_KEY=your_checksum_key
PAYOS_RETURN_URL=https://your-domain.com/payment/success
PAYOS_CANCEL_URL=https://your-domain.com/payment/cancel

# Socket.IO Configuration
# Socket.IO is enabled by default on the /payment namespace
# Clients connect to: ws://your-domain:4000/payment
# Events:
#   - join:branch { branchId, deviceId, deviceType }
#   - payment:success { orderId, orderCode, amount, transactionRef, ... }
#   - payment:cancelled { orderId, orderCode, reason }
#   - payment:expired { orderCode }

# Logger
CONFIG_LOGGER_LEVEL=debug
