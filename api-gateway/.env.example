# Gateway Configuration
SERVICE_PORT=4000

# Backend Services
API_ADMIN_URL=http://localhost:3002
API_DASHBOARD_URL=http://localhost:4002
API_OAUTH_URL=http://localhost:3005

# Web Frontend (for CORS)
WEB_ADMIN_URL=http://localhost:3001
WEB_DASHBOARD_URL=http://localhost:3000

# PayOS Configuration
# Get credentials from https://my.payos.vn/
PAYOS_CLIENT_ID=your_client_id
PAYOS_API_KEY=your_api_key
PAYOS_CHECKSUM_KEY=your_checksum_key
PAYOS_RETURN_URL=https://your-domain.com/payment/success
PAYOS_CANCEL_URL=https://your-domain.com/payment/cancel

# Firebase Configuration (for FCM push notifications)
# Option 1: Use service account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option 2: Use environment variables (alternative to file)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
